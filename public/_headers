# Cloudflare reads this file (other hosts ignore it).

# Cache rules (same as vercel.json)
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/version.json
  Cache-Control: no-store
/version.js
  Cache-Control: no-store
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# The single-file site (nex-velo.html + sw.js) can sit on any host and load the proxy engine from this server,
# so these files must be readable from other sites.
/scram/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
/libcurl/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
/baremux/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
/uv/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
/v86/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
/vm/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
/logo.png
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
/favicon.png
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
